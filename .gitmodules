[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "BayesAiken"]
	path = BayesAiken
	url = https://github.com/jventural/bayesaiken
[submodule "InterconectaR"]
	path = InterconectaR
	url = https://github.com/jventural/interconectar
[submodule "OptimalFactor"]
	path = OptimalFactor
	url = https://github.com/jventural/optimalfactor
[submodule "PsyML"]
	path = PsyML
	url = https://github.com/jventural/psyml
[submodule "PsyMetricTools"]
	path = PsyMetricTools
	url = https://github.com/jventural/psymetrictools
[submodule "ResponseScan"]
	path = ResponseScan
	url = https://github.com/cran/ResponseScan
[submodule "ThesiStats"]
	path = ThesiStats
	url = https://github.com/jventural/thesistats
